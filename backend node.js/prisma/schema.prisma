generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  nrp           String          @id @db.VarChar(255)
  password_hash String          @db.VarChar(255)
  role          user_roles
  is_active     Boolean         @default(true)
  mitra_id      Int?
  employee      employees?
  sessions      user_sessions[]
  mitra         mitras?         @relation(fields: [mitra_id], references: [mitra_id], onDelete: Cascade)

  @@index([mitra_id], map: "users_mitra_id_fkey")
}

model user_sessions {
  session_id String   @id @default(uuid())
  nrp        String   @db.VarChar(255)
  token      String   @db.Text
  ip_address String?  @db.VarChar(45)
  user_agent String?  @db.Text
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  expires_at DateTime
  user       users    @relation(fields: [nrp], references: [nrp], onDelete: Cascade)

  @@index([nrp])
}

model mitras {
  mitra_id     Int         @id @default(autoincrement())
  mitra_name   String      @db.VarChar(255)
  contact_pama String?     @db.VarChar(255)
  created_at   DateTime    @default(now())
  employees    employees[]
  users        users[]
}

model locations {
  location_id    Int                  @id @default(autoincrement())
  location_name  String               @db.VarChar(255)
  latitude       Decimal?             @db.Decimal(10, 8)
  longitude      Decimal?             @db.Decimal(11, 8)
  radius_meters  Int                  @default(50)
  polygon_coords String?              @db.Text
  employees_list employee_locations[]
  employees      employees[]
  positions      position_locations[]
}

model departments {
  dept_id   Int        @id @default(autoincrement())
  dept_name String     @db.VarChar(255)
  divisions department_divisions[]
  employees employees[]
}

model department_divisions {
  dept_id    Int
  div_id     Int
  department departments @relation(fields: [dept_id], references: [dept_id], onDelete: Cascade)
  division   divisions   @relation(fields: [div_id], references: [div_id], onDelete: Cascade)

  @@id([dept_id, div_id])
}

model divisions {
  div_id      Int                    @id @default(autoincrement())
  div_name    String                 @db.VarChar(255)
  departments department_divisions[]
  employees   employees[]
}

model positions {
  pos_id             Int                  @id @default(autoincrement())
  pos_name           String               @db.VarChar(255)
  allow_any_location Boolean              @default(false)
  employees          employees[]
  allowed_locations  position_locations[]
}

model position_locations {
  pos_id      Int
  location_id Int
  location    locations @relation(fields: [location_id], references: [location_id], onDelete: Cascade)
  position    positions @relation(fields: [pos_id], references: [pos_id], onDelete: Cascade)

  @@id([pos_id, location_id])
  @@index([location_id], map: "position_locations_location_id_fkey")
}

model employees {
  nrp                   String               @id @db.VarChar(255)
  full_name             String               @db.VarChar(255)
  pos_id                Int?
  div_id                Int?
  dept_id               Int?
  location_id           Int?
  default_work_location String?              @db.VarChar(255)
  mitra_id              Int?
  photo_profile         String?              @db.VarChar(255)
  allow_any_location    Boolean              @default(false)
  attendances           attendances[]
  division              divisions?           @relation(fields: [div_id], references: [div_id])
  department            departments?         @relation(fields: [dept_id], references: [dept_id])
  location              locations?           @relation(fields: [location_id], references: [location_id])
  mitra                 mitras?              @relation(fields: [mitra_id], references: [mitra_id], onDelete: Cascade)
  user                  users                @relation(fields: [nrp], references: [nrp])
  position              positions?           @relation(fields: [pos_id], references: [pos_id])
  allowed_locations     employee_locations[]
  ftw_reports           ftw_reports[]
  rosters               rosters[]

  @@index([div_id], map: "employees_div_id_fkey")
  @@index([dept_id], map: "employees_dept_id_fkey")
  @@index([location_id], map: "employees_location_id_fkey")
  @@index([pos_id], map: "employees_pos_id_fkey")
  @@index([mitra_id], map: "employees_mitra_id_fkey")
}

model employee_locations {
  nrp         String
  location_id Int
  location    locations @relation(fields: [location_id], references: [location_id], onDelete: Cascade)
  employee    employees @relation(fields: [nrp], references: [nrp], onDelete: Cascade)

  @@id([nrp, location_id])
  @@index([location_id], map: "employee_locations_location_id_fkey")
}

model shifts {
  shift_id          Int           @id @default(autoincrement())
  shift_code        String        @db.VarChar(255)
  time_in_expected  DateTime      @db.Time(0)
  time_out_expected DateTime      @db.Time(0)
  date_in           DateTime?     @db.Date
  date_out          DateTime?     @db.Date
  attendances       attendances[]
  rosters           rosters[]
}

model attendances {
  att_id          String      @id @default(uuid())
  nrp             String      @db.VarChar(255)
  attendance_date DateTime    @db.Date
  time_wita       DateTime    @db.Time(0)
  time_wib        DateTime    @db.Time(0)
  shift_id        Int
  trans_type      trans_types
  cp_location     String?     @db.VarChar(255)
  work_location   String?     @db.VarChar(255)
  att_latitude    Decimal?    @db.Decimal(10, 8)
  att_longitude   Decimal?    @db.Decimal(11, 8)
  att_map_link    String?     @db.Text
  photo_evidence  String?     @db.VarChar(255)
  device_ip       String?     @db.VarChar(45)
  date_in         DateTime?   @db.Date
  date_out        DateTime?   @db.Date
  employee        employees   @relation(fields: [nrp], references: [nrp], onDelete: Cascade)
  shift           shifts      @relation(fields: [shift_id], references: [shift_id])

  @@index([nrp], map: "attendances_nrp_fkey")
  @@index([shift_id], map: "attendances_shift_id_fkey")
}

model rosters {
  id              Int       @id @default(autoincrement())
  nrp             String    @db.VarChar(255)
  date            DateTime  @db.Date
  shift_id        Int?
  work_location   String?   @db.VarChar(255)
  date_in         DateTime? @db.Date
  date_out        DateTime? @db.Date
  actual_location String?   @db.VarChar(255)
  employee        employees @relation(fields: [nrp], references: [nrp], onDelete: Cascade)
  shift           shifts?   @relation(fields: [shift_id], references: [shift_id])

  @@unique([nrp, date])
  @@index([shift_id], map: "rosters_shift_id_fkey")
}

model ftw_reports {
  id                Int       @id @default(autoincrement())
  nrp               String    @db.VarChar(255)
  ftw_date          DateTime  @db.Date
  kehadiran_onsite  Boolean   @default(true)
  unit_dioperasikan String?   @db.VarChar(255)
  pola_shift        String    @db.VarChar(50)
  shift             String    @db.VarChar(50)
  jam_tidur_12_jam  String    @db.VarChar(50)
  jam_tidur_36_jam  String    @db.VarChar(50)
  jam_bangun        String    @db.VarChar(5)
  konsumsi_obat     Boolean
  punya_masalah     Boolean
  gejala_kesehatan  Boolean
  status_ftw        String?   @db.VarChar(50)
  created_at        DateTime  @default(now())
  employee          employees @relation(fields: [nrp], references: [nrp], onDelete: Cascade)

  @@unique([nrp, ftw_date])
}

enum user_roles {
  admin
  admin_mitra
  employee
}

enum trans_types {
  Check_in  @map("Check-in")
  Check_out @map("Check-out")
  Izin
  Sakit
}

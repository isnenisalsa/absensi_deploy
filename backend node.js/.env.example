# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Railway MySQL: copy dari Railway Dashboard → Backend service → Variables
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="ganti_dengan_string_random_panjang_di_production"

# ─── SERVER ───────────────────────────────────────────────────────────────────
# Railway mengatur PORT otomatis, jangan hardcode
PORT=3000
